# Expo Public API URL for development
# 
# On Windows, find your IPv4 address with: ipconfig
# Then set: EXPO_PUBLIC_API_URL=http://<YOUR_IPv4>:5000
#
# Example: EXPO_PUBLIC_API_URL=http://192.168.1.42:5000
#
# Important: 
# - Do NOT use localhost or 127.0.0.1 on the phone - these refer to the phone itself
# - The API must be reachable from the phone on the same Wi-Fi network
# - API should be listening on 0.0.0.0:5000 for development
#
EXPO_PUBLIC_API_URL=http://192.168.68.105:5000