{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=dj_requests;Username=placeholder;Password=placeholder"
  },
  "AuthRateLimits": {
    "RegisterPermitLimit": 5,
    "LoginPermitLimit": 10,
    "RefreshPermitLimit": 20,
    "WindowMinutes": 1
  },
  "AdminAuthRateLimits": {
    "LoginPermitLimit": 10,
    "RefreshPermitLimit": 20,
    "WindowMinutes": 1
  },
  "GuestRateLimits": {
    "PostPermitLimit": 60,
    "GetPermitLimit": 120,
    "WindowMinutes": 1
  },
  "Frontend": {
    "BaseUrl": "https://localhost:3000"
  },
  "FileStorage": {
    "Path": "storage/profiles",
    "PublicUrlBase": "",
    "MaxFileSizeBytes": 5242880,
    "MaxDimensionPx": 2048,
    "MaxSourcePixels": 50000000
  },
  "Retention": {
    "Enabled": false,
    "IntervalMinutes": 15,
    "BatchSize": 100
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}